                    <Combinator xsi:type="rx:WithLatestFrom" />
                  </Expression>
                  <Expression xsi:type="scr:ExpressionCondition">
                    <scr:Name>SamePorts</scr:Name>
                    <scr:Expression>it.Item1.PortName == it.Item2</scr:Expression>
                  </Expression>
