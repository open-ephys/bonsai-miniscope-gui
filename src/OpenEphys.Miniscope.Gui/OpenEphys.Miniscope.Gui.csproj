<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Title>OpenEphys.Miniscope.Gui</Title>
    <Description>Bonsai library that contains the Open Ephys Miniscope V4 GUI, a custom GUI for using Miniscopes.</Description>
    <PackageTags>Bonsai Rx Open Ephys Miniscope Imaging Calcium Gui</PackageTags>
    <TargetFrameworks>net472</TargetFrameworks>
    <UseWindowsForms>true</UseWindowsForms>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Bonsai.Design" Version="2.9.1" />
    <PackageReference Include="Bonsai.ImGui" Version="0.2.0" />
    <PackageReference Include="Bonsai.ImGui.Design" Version="0.2.0" />
    <PackageReference Include="Bonsai.ImGui.Visualizers" Version="0.2.0" />
    <PackageReference Include="Bonsai.ImPlot" Version="0.2.0" />
    <PackageReference Include="Bonsai.Scripting.Expressions" Version="2.10.0" />
    <PackageReference Include="Bonsai.Vision" Version="2.9.1" />
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="3.3.4" PrivateAssets="all" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="OpenEphys.Miniscope" Version="0.5.0" />
    <PackageReference Include="OpenEphys.Commutator" Version="0.3.1" />
    <PackageReference Include="YamlDotNet" Version="16.3.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="OpenEphys.Miniscope.Gui.Tests" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="**\*.bonsai" />
    <EmbeddedResource Include="Fonts\*" />
    <EmbeddedResource Include="Resources\icon.ico" />
  </ItemGroup>

  <PropertyGroup>
    <SettingsSchema>Configuration/miniscope-config.schema.json</SettingsSchema>
    <SettingsGenerated>Configuration/Settings.cs</SettingsGenerated>
    <DotnetToolManifest>$(MSBuildThisFileDirectory)../../.config/dotnet-tools.json</DotnetToolManifest>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="$(SettingsGenerated)" />
  </ItemGroup>

  <Target Name="GenerateSettings" Condition="'$(DesignTimeBuild)' != 'true'" Inputs="$(SettingsSchema);$(DotnetToolManifest)" Outputs="$(SettingsGenerated)">
    <Exec Command="dotnet tool restore" />
    <Exec Command="dotnet bonsai.sgen &quot;$(SettingsSchema)&quot; -o Configuration --name Settings --namespace OpenEphys.Miniscope.Gui --serializer yaml" />
  </Target>

  <Target Name="IncludeGeneratedSettings" BeforeTargets="BeforeCompile;CoreCompile" DependsOnTargets="GenerateSettings">
    <ItemGroup>
      <Compile Include="$(SettingsGenerated)" />
    </ItemGroup>
  </Target>

</Project>
